  "components": {
    "schemas": {
      "CFDSurrogateRequest": {
        "properties": {
          "airfoil_code": {
            "type": "string",
            "maxLength": 5,
            "minLength": 4,
            "title": "Airfoil Code",
            "default": "2412"
          },
          "alpha_deg": {
            "type": "number",
            "title": "Alpha Deg",
            "default": 4.0
          },
          "reynolds": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Reynolds",
            "default": 1000000.0
          }
        },
        "type": "object",
        "title": "CFDSurrogateRequest"
      },
      "CompressibleGasRequest": {
        "properties": {
          "mach": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Mach",
            "default": 2.0
          },
          "gamma": {
            "type": "number",
            "exclusiveMinimum": 1.0,
            "title": "Gamma",
            "default": 1.4
          }
        },
        "type": "object",
        "title": "CompressibleGasRequest"
      },
      "FlightSimulationRequest": {
        "properties": {
          "initial_mass_kg": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Initial Mass Kg",
            "default": 50.0
          },
          "dry_mass_kg": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Dry Mass Kg",
            "default": 30.0
          },
          "thrust_n": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Thrust N",
            "default": 2500.0
          },
          "burn_time_s": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Burn Time S",
            "default": 3.5
          },
          "drag_area_m2": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Drag Area M2",
            "default": 0.035
          }
        },
        "type": "object",
        "title": "FlightSimulationRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HandshakeEvaluateRequest": {
        "properties": {
          "task_id": {
            "type": "string",
            "title": "Task Id",
            "description": "Handshake benchmark task identifier",
            "default": "AERO-001"
          },
          "patch_text": {
            "type": "string",
            "title": "Patch Text",
            "description": "Unified candidate patch code",
            "default": ""
          },
          "model_name": {
            "type": "string",
            "title": "Model Name",
            "description": "Model identifier",
            "default": "Candidate-Agent"
          }
        },
        "type": "object",
        "title": "HandshakeEvaluateRequest"
      },
      "MCPInvokeRequest": {
        "properties": {
          "tool_name": {
            "type": "string",
            "title": "Tool Name",
            "description": "Registered MCP tool name"
          },
          "arguments": {
            "additionalProperties": true,
            "type": "object",
            "title": "Arguments",
            "description": "Arguments dictionary"
          }
        },
        "type": "object",
        "required": [
          "tool_name"
        ],
        "title": "MCPInvokeRequest"
      },
      "OrbitPredictionRequest": {
        "properties": {
          "norad_cat_id": {
            "type": "integer",
            "title": "Norad Cat Id",
            "default": 25544
          },
          "observer_lat_deg": {
            "type": "number",
            "title": "Observer Lat Deg",
            "default": 17.385
          },
          "observer_lon_deg": {
            "type": "number",
            "title": "Observer Lon Deg",
            "default": 78.4867
          },
          "observer_alt_m": {
            "type": "number",
            "title": "Observer Alt M",
            "default": 542.0
          }
        },
        "type": "object",
        "title": "OrbitPredictionRequest"
      },
      "OrbitalTransferRequest": {
        "properties": {
          "r1_km": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "R1 Km",
            "default": 6700.0
          },
          "r2_km": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "R2 Km",
            "default": 42164.0
          },
          "inclination_deg": {
            "type": "number",
            "minimum": 0.0,
            "title": "Inclination Deg",
            "default": 0.0
          }
        },
        "type": "object",
        "title": "OrbitalTransferRequest"
      },
      "SimulationRunCreateRequest": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "default": "Suborbital Sounding Flight"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "default": "COMPLETED"
          },
          "apogee_km": {
            "type": "number",
            "title": "Apogee Km",
            "default": 120.5
          },
          "max_mach": {
            "type": "number",
            "title": "Max Mach",
            "default": 3.85
          },
          "max_q_kpa": {
            "type": "number",
            "title": "Max Q Kpa",
            "default": 48.2
          },
          "delta_v_m_s": {
            "type": "number",
            "title": "Delta V M S",
            "default": 2150.0
          },
          "duration_s": {
            "type": "number",
            "title": "Duration S",
            "default": 285.0
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          },
          "events": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Events"
          }
        },
        "type": "object",
        "title": "SimulationRunCreateRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}